# Copy to .env for local runs and fill in. Never commit the real .env.
# In Azure Container Apps, set these as secrets / environment variables instead.

# --- Azure OpenAI (Responses API + web_search tool) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# --- Tool settings (defaults live in backend/config.py; values here override them) ---
# In Azure App Service / Container Apps, set these as app settings instead (.env is not deployed).
# Optional, not listed: WEBSEARCH_DATA_DIR (SQLite history + logs folder, default ./data;
# keep it on local disk, not an Azure Files mount) and WEBSEARCH_CORS_ORIGINS (default empty =
# CORS off; the UI is same-origin - only list other origins that must call the API).

# Azure OpenAI request tuning
WEBSEARCH_REQUEST_TIMEOUT=180
WEBSEARCH_MAX_OUTPUT_TOKENS=3500
WEBSEARCH_TEMPERATURE=0.2
# low | medium | high
WEBSEARCH_SEARCH_CONTEXT_SIZE=high

# Concurrency
WEBSEARCH_BATCH_CONCURRENCY=3
WEBSEARCH_SITE_FANOUT_CONCURRENCY=5

# Retries / fallbacks
WEBSEARCH_LOW_CONFIDENCE_RETRY_THRESHOLD=0.5
WEBSEARCH_LOW_CONFIDENCE_MAX_RETRIES=3
WEBSEARCH_JSON_MAX_RETRIES=3
WEBSEARCH_BROAD_SEARCH_MAX_ATTEMPTS=2

# Firearms retailer domains (comma-separated) - every firearms lookup is searched across ALL of these.
# (Smartphones has no site setting: each row's Target Website decides where to search.)
WEBSEARCH_FIREARMS_SITES=academy.com,basspro.com,budsgunshop.com,cabelas.com,discountgunmart.com,guns.com,palmettostatearmory.com,rockislandauction.com,spiketactical.com,sportsmans.com,sportsmansoutdoorsuperstore.com
